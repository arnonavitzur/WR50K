# macOS
.DS_Store

# Local tooling / editor config
.claude/

# Local-only project docs and coaching context
CLAUDE.md
context_v2.md

# Plan sources and the merge script are TRACKED — CI rebuilds combined_plan.json
# from them on push. See .github/workflows/plan-merge.yml.
# Dated local backups of those sources are not, e.g. "run_plan (07302026).json".
# No tracked plan file has a space in its name, so this cannot shadow a real one.
*_plan (*).json

# Retired: inject_plan.py inlined the plan into the HTML (the app now fetches
# combined_plan.json). update_plan.py patched one section of the combined file,
# which a full CI re-merge makes unnecessary. Kept local, out of the repo.
inject_plan.py
update_plan.py

# FIT parser reference implementation — fit-analysis.js is what ships.
# Kept local so parser logic can be developed in Python and ported over.
*fit_parser*.py
section-fit-parser.py

# Test fixtures — real activity files, not needed in the repo
*.fit

# update_plan.py imports merge_plans.py, so running it byte-compiles the module
__pycache__/
*.pyc
