{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "training-plan-master-v1.7",
 "title": "Master Training Plan Schema",
 "description": "Canonical schema for run, strength, and nutrition plans. v1.2: nutrition uses day_types with session_fueling (array, linked to sessions), structured supplement timing, session-centric daily view. v1.3: hr_zone enum extended with range labels (Z1-2, Z2-3 per HR_Zone_Gap_Report_v1; Z3-4 added forward-looking); $id bumped; per-block instance fields (athlete/race/dates) removed from the schema header - they live in each plan's meta. CONVENTION: hr_zone = the INTENDED EXECUTION BAND for the session (range labels where intent spans a boundary); hr_cap_bpm = the HARD CEILING / alarm value, which may legitimately sit above the intended band as a tripwire. Zone bands @ LTHR 168 (corrected, contiguous): Z1 <142, Z2 142-150, Z3 151-158, Z4 159-167, Z5a 168-171. v1.4: plan_type_required_fields is now ENFORCED via allOf/if-then on meta.plan_type (run & strength require daily_routines, session_protocols, weeks; nutrition requires day_types, supplements). The informational plan_type_required_fields block is retained as documentation; the allOf clauses are the enforcement. v1.5 (run_plan rev 1.9): optional run_session.terrain_intent. v1.6 (Tuscany cycle, 2026-09-30), ADDITIVE ONLY: run_session.hr_anchor (what hr_cap_bpm is computed from - Uphill Athlete AeT model), run_session.aet_gate (conditional if_pass version of a gated session; load fields identical in both versions), week.weekly_targets.run_hours_est / recovery_week / derived_from / derivation_rule, strength_session.warmup_protocol, and documented meta fields (revision, revision_notes, lthr_*, aet_*). NOTE: the Friel hr_zone bands listed here remain the LABEL set; under the v1.6 AeT model the cap value comes from hr_anchor + meta.aet_bpm. v1.7 (2026-09-30), ADDITIVE ONLY: new cross_session definition (type 'cross'; subtype swim|bike|hike|other) allowed in day.sessions; linked_session.type gains 'cross'; nutrition triggers gain optional cross_subtype (a trigger WITH it matches only when that cross session is scheduled; a trigger WITHOUT it ignores cross sessions - backward compatible); weekly_targets gain swim_sessions and swim_minutes (derived). Cross sessions carry the athlete's cross-training; they never enter run sums or the ramp guard.",
 "version": "1.7",
 "definitions": {
  "exercise": {
   "type": "object",
   "required": [
    "name",
    "category"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "category": {
     "type": "string",
     "enum": [
      "eccentric_quad",
      "hip_stability",
      "calf",
      "core",
      "upper_body",
      "corrective",
      "mobility",
      "activation",
      "balance"
     ]
    },
    "sets": {
     "type": "integer"
    },
    "reps": {
     "type": [
      "integer",
      "string"
     ]
    },
    "duration_sec": {
     "type": "integer"
    },
    "tempo": {
     "type": "string"
    },
    "load": {
     "type": "string",
     "enum": [
      "heavy",
      "moderate",
      "light",
      "bodyweight"
     ]
    },
    "side": {
     "type": "string",
     "enum": [
      "both",
      "left",
      "right",
      "alternating"
     ]
    },
    "cue": {
     "type": "string"
    },
    "progression_note": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "daily_routine": {
   "description": "Short recurring daily block. App injects into every day automatically. Used by run and strength plans.",
   "type": "object",
   "required": [
    "id",
    "title",
    "timing",
    "duration_min",
    "exercises",
    "active_weeks"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "timing": {
     "type": "string",
     "enum": [
      "morning",
      "evening",
      "pre_run",
      "post_run",
      "anytime"
     ]
    },
    "duration_min": {
     "type": "number"
    },
    "exercises": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/exercise"
     }
    },
    "active_weeks": {
     "type": "string",
     "pattern": "^\\d+(-\\d+)?$"
    },
    "phase_overrides": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "weeks",
       "modification"
      ],
      "properties": {
       "weeks": {
        "type": "string"
       },
       "modification": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      }
     }
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "session_protocol": {
   "description": "Warmup or cooldown block attached to a session type. Used by run and strength plans.",
   "type": "object",
   "required": [
    "duration_min",
    "exercises"
   ],
   "properties": {
    "duration_min": {
     "type": "number"
    },
    "exercises": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/exercise"
     }
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "run_session": {
   "type": "object",
   "required": [
    "type",
    "subtype",
    "title"
   ],
   "properties": {
    "type": {
     "type": "string",
     "const": "run"
    },
    "subtype": {
     "type": "string",
     "enum": [
      "easy",
      "tempo",
      "long",
      "power_climb",
      "race_pace",
      "back_to_back",
      "shakeout",
      "rest",
      "time_trial"
     ]
    },
    "title": {
     "type": "string"
    },
    "duration_min": {
     "type": "number"
    },
    "distance_mi": {
     "type": "number"
    },
    "elevation_gain_ft": {
     "type": "number"
    },
    "terrain": {
     "type": "string",
     "enum": [
      "road",
      "trail",
      "mixed"
     ]
    },
    "hr_cap_bpm": {
     "type": "integer",
     "description": "Hard ceiling / alarm value in bpm. May legitimately sit above the intended hr_zone band as a tripwire; when it does, hr_zone should be a range label or the cap rationale noted in the session."
    },
    "hr_zone": {
     "type": "string",
     "enum": [
      "Z1",
      "Z1-2",
      "Z2",
      "Z2-3",
      "Z3",
      "Z3-4",
      "Z4",
      "Z5a"
     ],
     "description": "Intended execution band. Range labels (Z1-2, Z2-3) where intent spans a boundary. Bands @ LTHR 168: Z1 <142, Z2 142-150, Z3 151-158, Z4 159-167, Z5a 168-171."
    },
    "pace_target": {
     "type": "object",
     "properties": {
      "min_per_mi_slow": {
       "type": "string"
      },
      "min_per_mi_fast": {
       "type": "string"
      }
     }
    },
    "poles": {
     "type": "boolean"
    },
    "key_cue": {
     "type": "string"
    },
    "fueling_required": {
     "type": "boolean"
    },
    "fueling_notes": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    },
    "terrain_intent": {
     "type": "string",
     "enum": [
      "free",
      "grade",
      "relief",
      "relief+grade",
      "footing"
     ],
     "description": "What the terrain must deliver. Governs over terrain (advisory). Absent = UNCLASSIFIED, never free."
    },
    "hr_anchor": {
     "type": "string",
     "enum": [
      "AeT",
      "AeT_minus_10pct",
      "AeT_to_LT",
      "AeT_test",
      "none"
     ],
     "description": "Reference the hr_cap_bpm is computed from (meta.aet_bpm, meta.lthr_bpm). Patch revisions recompute caps after each AeT test."
    },
    "aet_gate": {
     "type": "object",
     "description": "Session gated on the Uphill Athlete AeT/LT 10% rule. The app renders active_version; a promotion copies if_pass over the top-level fields.",
     "required": [
      "slot",
      "active_version",
      "if_pass"
     ],
     "properties": {
      "slot": {
       "type": "string"
      },
      "active_version": {
       "type": "string",
       "enum": [
        "default",
        "if_pass"
       ]
      },
      "default_rationale": {
       "type": "string"
      },
      "pass_rule": {
       "type": "string"
      },
      "if_pass": {
       "type": "object",
       "properties": {
        "subtype": {
         "$ref": "#/definitions/run_session/properties/subtype"
        },
        "title": {
         "type": "string"
        },
        "hr_zone": {
         "$ref": "#/definitions/run_session/properties/hr_zone"
        },
        "hr_cap_bpm": {
         "type": "integer"
        },
        "hr_anchor": {
         "$ref": "#/definitions/run_session/properties/hr_anchor"
        },
        "key_cue": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "strength_session": {
   "type": "object",
   "required": [
    "type",
    "subtype",
    "title",
    "exercises"
   ],
   "properties": {
    "type": {
     "type": "string",
     "const": "strength"
    },
    "subtype": {
     "type": "string",
     "enum": [
      "full",
      "lower",
      "upper",
      "core",
      "mobility_session",
      "correctives_extended"
     ]
    },
    "title": {
     "type": "string"
    },
    "duration_min": {
     "type": "number"
    },
    "exercises": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/exercise"
     }
    },
    "notes": {
     "type": "string"
    },
    "warmup_protocol": {
     "type": "string",
     "enum": [
      "pre_lower",
      "pre_upper"
     ]
    }
   }
  },
  "linked_session": {
   "description": "Identifies which session a nutrition entry is tied to. Used in session_fueling to link pre/during/post nutrition to specific sessions.",
   "type": "object",
   "required": [
    "type",
    "position"
   ],
   "properties": {
    "type": {
     "type": "string",
     "enum": [
      "run",
      "strength",
      "cross"
     ],
     "description": "Which session type this nutrition links to"
    },
    "subtype": {
     "type": [
      "string",
      "null"
     ],
     "description": "Optional: specific subtype (easy, tempo, lower, upper, swim, etc.). Null = any session of that type."
    },
    "position": {
     "type": "string",
     "enum": [
      "pre",
      "during",
      "post"
     ],
     "description": "When relative to the session"
    }
   }
  },
  "session_fueling_entry": {
   "description": "Nutrition prescription linked to a specific session on a given day type. The app renders this directly next to the session it belongs to.",
   "type": "object",
   "required": [
    "linked_session"
   ],
   "properties": {
    "linked_session": {
     "$ref": "#/definitions/linked_session"
    },
    "timing": {
     "type": "string",
     "description": "Human-readable timing, e.g. '90 min before run', 'within 30 min after'"
    },
    "calories": {
     "type": "integer",
     "description": "Target calories for this pre/during/post window"
    },
    "carbs_g": {
     "type": "integer"
    },
    "protein_g": {
     "type": "integer"
    },
    "fat_g": {
     "type": "integer"
    },
    "sodium_mg": {
     "type": "integer"
    },
    "fluid_ml": {
     "type": "integer"
    },
    "foods": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Suggested foods for this window"
    },
    "fueling_schedule": {
     "type": "array",
     "description": "For position: 'during' only. Timed items to consume during the session.",
     "items": {
      "type": "object",
      "properties": {
       "interval_min": {
        "type": "integer"
       },
       "item": {
        "type": "string"
       },
       "cal": {
        "type": "integer"
       },
       "sodium_mg": {
        "type": "integer"
       },
       "caffeine_mg": {
        "type": "integer"
       }
      }
     }
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "nutrition_day_type": {
   "description": "Template for nutrition on a specific type of training day. The app resolves which applies by matching scheduled sessions against triggers.",
   "type": "object",
   "required": [
    "id",
    "label",
    "triggers",
    "daily_targets"
   ],
   "properties": {
    "id": {
     "type": "string",
     "description": "Unique ID, e.g. 'easy_run_lower_strength'"
    },
    "label": {
     "type": "string",
     "description": "Human-readable name, e.g. 'Easy run + lower strength day'"
    },
    "triggers": {
     "type": "array",
     "description": "Session combinations that select this day type. First match wins.",
     "items": {
      "type": "object",
      "properties": {
       "run_subtype": {
        "type": [
         "string",
         "null"
        ]
       },
       "strength_subtype": {
        "type": [
         "string",
         "null"
        ]
       },
       "description": {
        "type": "string"
       },
       "cross_subtype": {
        "type": [
         "string",
         "null"
        ],
        "description": "Optional (v1.7). Present: matches only when a cross session of this subtype is scheduled that day. Absent: cross sessions are ignored."
       }
      }
     }
    },
    "daily_targets": {
     "type": "object",
     "description": "Macro and calorie targets for the full day. Shown as a summary card in the app.",
     "required": [
      "calories_total",
      "carbs_g",
      "protein_g",
      "fat_g",
      "fluid_ml_total"
     ],
     "properties": {
      "calories_total": {
       "type": "integer"
      },
      "carbs_g": {
       "type": "integer"
      },
      "protein_g": {
       "type": "integer"
      },
      "fat_g": {
       "type": "integer"
      },
      "fluid_ml_total": {
       "type": "integer"
      },
      "general_guidance": {
       "type": "string",
       "description": "Brief plain-language guidance for non-session meals, e.g. 'Higher carb day. Prioritise carbs at lunch and dinner. Protein with every meal.'"
      },
      "notes": {
       "type": "string"
      }
     }
    },
    "session_fueling": {
     "type": "array",
     "description": "Array of pre/during/post nutrition entries, each linked to a specific session. The app renders each entry next to the session it belongs to.",
     "items": {
      "$ref": "#/definitions/session_fueling_entry"
     }
    },
    "phase_adjustments": {
     "type": "array",
     "description": "How this day type's targets change across training phases.",
     "items": {
      "type": "object",
      "required": [
       "phase",
       "adjustment"
      ],
      "properties": {
       "phase": {
        "type": "string",
        "enum": [
         "Base",
         "Build",
         "Peak",
         "Taper_1",
         "Taper_2",
         "Race_week"
        ]
       },
       "adjustment": {
        "type": "string"
       },
       "modified_targets": {
        "type": "object",
        "properties": {
         "calories_total": {
          "type": "integer"
         },
         "carbs_g": {
          "type": "integer"
         },
         "protein_g": {
          "type": "integer"
         },
         "fat_g": {
          "type": "integer"
         }
        }
       }
      }
     }
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "supplement": {
   "description": "A supplement with dosage, timing, and rationale.",
   "type": "object",
   "required": [
    "name",
    "dose",
    "timing",
    "timing_slot"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "dose": {
     "type": "string",
     "description": "e.g. '2000 IU', '400mg'"
    },
    "timing": {
     "type": "string",
     "description": "Human-readable: 'morning with food', 'before bed'"
    },
    "timing_slot": {
     "type": "string",
     "enum": [
      "morning",
      "with_meals",
      "pre_run",
      "post_run",
      "evening"
     ],
     "description": "Structured slot for app rendering order"
    },
    "rationale": {
     "type": "string"
    },
    "active_weeks": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "nutrition_date_override": {
   "description": "Specific-date nutrition that replaces the day_type. For race day, fueling tests, carb-loading, etc.",
   "type": "object",
   "required": [
    "date",
    "reason"
   ],
   "properties": {
    "date": {
     "type": "string",
     "format": "date"
    },
    "reason": {
     "type": "string"
    },
    "daily_targets": {
     "type": "object",
     "properties": {
      "calories_total": {
       "type": "integer"
      },
      "carbs_g": {
       "type": "integer"
      },
      "protein_g": {
       "type": "integer"
      },
      "fat_g": {
       "type": "integer"
      },
      "fluid_ml_total": {
       "type": "integer"
      },
      "general_guidance": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      }
     }
    },
    "session_fueling": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/session_fueling_entry"
     }
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "day": {
   "description": "A single calendar day. Used by run and strength plans only.",
   "type": "object",
   "required": [
    "date",
    "day_of_week"
   ],
   "properties": {
    "date": {
     "type": "string",
     "format": "date"
    },
    "day_of_week": {
     "type": "string",
     "enum": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
     ]
    },
    "flex": {
     "type": "boolean"
    },
    "rest_day": {
     "type": "boolean"
    },
    "sessions": {
     "type": "array",
     "items": {
      "oneOf": [
       {
        "$ref": "#/definitions/run_session"
       },
       {
        "$ref": "#/definitions/strength_session"
       },
       {
        "$ref": "#/definitions/cross_session"
       }
      ]
     }
    },
    "day_notes": {
     "type": "string"
    }
   }
  },
  "week": {
   "type": "object",
   "required": [
    "week_number",
    "start_date",
    "phase",
    "days"
   ],
   "properties": {
    "week_number": {
     "type": "integer",
     "minimum": 1
    },
    "start_date": {
     "type": "string",
     "format": "date"
    },
    "phase": {
     "type": "string",
     "enum": [
      "Base",
      "Build",
      "Peak",
      "Taper_1",
      "Taper_2",
      "Race_week"
     ]
    },
    "weekly_targets": {
     "type": "object",
     "properties": {
      "mileage_mi": {
       "type": "number"
      },
      "vertical_ft": {
       "type": "number"
      },
      "long_run_mi": {
       "type": "number"
      },
      "strength_sessions": {
       "type": "integer"
      },
      "key_fueling_test": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "run_hours_est": {
       "type": "number",
       "description": "DERIVED: sum of run duration_min (race_pace excluded) / 60."
      },
      "recovery_week": {
       "type": "boolean",
       "description": "Recovery-class week. The ramp guard's reference week is the most recent week with recovery_week = false."
      },
      "derived_from": {
       "type": "string"
      },
      "derivation_rule": {
       "type": "string"
      },
      "swim_sessions": {
       "type": "integer",
       "description": "DERIVED: count of cross/swim sessions."
      },
      "swim_minutes": {
       "type": "number",
       "description": "DERIVED: sum of cross/swim duration_min."
      }
     }
    },
    "week_notes": {
     "type": "string"
    },
    "days": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/day"
     },
     "minItems": 7,
     "maxItems": 7
    }
   }
  },
  "cross_session": {
   "type": "object",
   "required": [
    "type",
    "subtype",
    "title"
   ],
   "description": "Cross-training session (swim, bike, hike). Rendered like other sessions; excluded from run mileage/vertical sums and from strength_sessions counts.",
   "properties": {
    "type": {
     "type": "string",
     "const": "cross"
    },
    "subtype": {
     "type": "string",
     "enum": [
      "swim",
      "bike",
      "hike",
      "other"
     ]
    },
    "method": {
     "type": "string",
     "description": "e.g. 'Total Immersion'"
    },
    "title": {
     "type": "string"
    },
    "duration_min": {
     "type": "number"
    },
    "distance_m": {
     "type": "number"
    },
    "intensity": {
     "type": "string",
     "enum": [
      "recovery",
      "easy",
      "steady"
     ]
    },
    "hr_cap_bpm": {
     "type": "integer",
     "description": "Optional. Running AeT caps do not transfer to swimming."
    },
    "key_cue": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    }
   }
  }
 },
 "type": "object",
 "required": [
  "meta"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "plan_type",
    "athlete",
    "race_date",
    "plan_start"
   ],
   "properties": {
    "plan_type": {
     "type": "string",
     "enum": [
      "run",
      "strength",
      "nutrition"
     ]
    },
    "schema_version": {
     "type": "string",
     "enum": [
      "1.2",
      "1.3",
      "1.4",
      "1.5",
      "1.6",
      "1.7"
     ],
     "description": "1.2 legacy; 1.3 hr_zone range labels; 1.4 enforced plan_type fields; 1.5 terrain_intent; 1.6 hr_anchor + aet_gate + weekly derived fields. 1.7 cross_session (swim) + cross nutrition links."
    },
    "athlete": {
     "type": "string"
    },
    "race": {
     "type": "string"
    },
