 "app_daily_view_assembly": {
  "description": "How the app builds the session-centric daily view.",
  "steps": [
   "1. Load all three JSON files (run, strength, nutrition)",
   "2. For the requested date, get scheduled sessions from run and strength plans (strength plan may also carry type 'cross' sessions, e.g. swims)",
   "3. Inject daily_routines from run + strength (filtered by active_weeks + phase_overrides)",
   "4. Inject session_protocols (pre/post) around each session",
   "5. NUTRITION: check date_overrides for exact date match. If found, use it.",
   "6. If no override, match the day's sessions against day_types[].triggers (run_subtype, strength_subtype, and cross_subtype when the trigger has it). First match wins.",
   "7. Apply phase_adjustments from matched day_type based on current week's phase.",
   "8. For each session, find its matching session_fueling entries (by linked_session.type + position; type may be run, strength or cross)",
   "9. Inject supplements (filtered by active_weeks), grouped by timing_slot",
   "10. Render the daily card:"
  ],
  "daily_card_structure": [
   "DAILY MACRO TARGETS (from daily_targets: total cal, carbs, protein, fat, fluid + general_guidance)",
   "",
   "SUPPLEMENTS",
   "  Morning: [supplements where timing_slot = morning]",
   "  With meals: [supplements where timing_slot = with_meals]",
   "",
   "SESSION 1: [e.g. Easy Z2 trail run]",
   "  PRE:    [session_fueling where linked_session.type=run, position=pre]",
   "  WARMUP: [session_protocol.pre_run]",
   "  RUN:    [run session details]",
   "  COOLDOWN: [session_protocol.post_run]",
   "  POST:   [session_fueling where linked_session.type=run, position=post]",
   "",
   "SESSION 2: [e.g. Lower body strength]",
   "  PRE:    [session_fueling where linked_session.type=strength, position=pre]",
   "  WARMUP: [session_protocol.pre_strength]",
   "  STRENGTH: [strength session details]",
   "  COOLDOWN: [session_protocol.post_strength]",
   "  POST:   [session_fueling where linked_session.type=strength, position=post]",
   "",
   "EVENING SUPPLEMENTS",
   "  [supplements where timing_slot = evening]",
   "",
   "DAILY ROUTINES",
   "  [foot correctives, hip activation, etc.]"
  ]
 },
 "example_day_type": {
  "description": "Worked example: easy run + lower strength double-day.",
  "example": {
   "id": "easy_run_lower_strength",
   "label": "Easy run + lower body strength (double-day)",
   "triggers": [
    {
     "run_subtype": "easy",
     "strength_subtype": "lower",
     "description": "Easy run AM + lower strength PM"
    }
   ],
   "daily_targets": {
    "calories_total": 2800,
    "carbs_g": 380,
    "protein_g": 150,
    "fat_g": 80,
    "fluid_ml_total": 3000,
    "general_guidance": "Moderate-high carb day to fuel both sessions. Prioritise protein at post-run and post-strength meals. Carb-rich lunch between sessions."
   },
   "session_fueling": [
    {
     "linked_session": {
      "type": "run",
      "position": "pre"
     },
     "timing": "60-90 min before run",
     "calories": 400,
     "carbs_g": 60,
     "protein_g": 15,
     "foods": [
      "oatmeal with banana",
      "coffee"
     ],
     "notes": "Light and familiar. Don't experiment."
    },
    {
     "linked_session": {
      "type": "run",
      "position": "post"
     },
     "timing": "Within 30 min of finishing",
     "calories": 300,
     "carbs_g": 40,
     "protein_g": 30,
     "foods": [
      "protein shake",
      "banana"
     ],
     "notes": "Quick recovery \u2014 strength session later today"
    },
    {
     "linked_session": {
      "type": "strength",
      "position": "pre"
     },
     "timing": "60 min before strength",
     "calories": 250,
     "carbs_g": 35,
     "protein_g": 15,
     "foods": [
      "rice cakes with peanut butter",
      "water"
     ],
     "notes": "Enough to fuel the session, not so much to feel heavy"
    },
    {
     "linked_session": {
      "type": "strength",
      "position": "post"
     },
     "timing": "Within 30 min of finishing",
     "calories": 350,
     "carbs_g": 40,
     "protein_g": 35,
     "foods": [
      "chicken and rice",
      "vegetables"
     ],
     "notes": "Largest protein dose of the day \u2014 eccentric quad recovery"
    }
   ],
   "phase_adjustments": [
    {
     "phase": "Taper_1",
     "adjustment": "Reduce total cal ~10% as volume drops; maintain protein at 150g"
    }
   ]
  }
 },
